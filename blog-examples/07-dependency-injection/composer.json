{
    "name": "webfiori/blog-03-dependency-injection",
    "description": "Blog example: Dependency Injection with WebFiori",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "webfiori/framework": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml"
    }
}

{
    "name": "webfiori/blog-17-cli-commands",
    "description": "Blog example: CLI commands — arguments, output, tables, testing with CommandTestCase",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "webfiori/framework": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml"
    }
}
